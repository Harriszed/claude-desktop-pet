{
  "name": "claude-desktop-pet",
  "version": "1.3.0",
  "private": false,
  "description": "A desktop Claude mascot that reacts to every Claude Code session.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "install-hooks": "node install-hooks.js",
    "uninstall-hooks": "node install-hooks.js --remove",
    "test": "node --test tests/*.test.js",
    "predist": "node scripts/build-icon.js",
    "dist": "electron-builder --publish never",
    "dist:win": "node scripts/build-icon.js && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "node scripts/build-icon.js && electron-builder --mac --universal --publish never",
    "dist:linux": "node scripts/build-icon.js && electron-builder --linux --x64 --publish never",
    "pack": "node scripts/build-icon.js && electron-builder --dir --publish never",
    "test:smoke": "node scripts/smoke-test.js",
    "test:packaged": "node scripts/smoke-test.js --packaged"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.64.0"
  },
  "license": "MIT",
  "author": "Harriszed",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Harriszed/claude-desktop-pet.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "desktop-pet",
    "electron",
    "pixel-art"
  ],
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "uk.mhzdev.claude-desktop-pet",
    "productName": "Claude Desktop Pet",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "settings-preload.js",
      "index.html",
      "settings.html",
      "settings.css",
      "settings.js",
      "sounds.js",
      "hook.js",
      "hook-settings.js",
      "platform.js",
      "updates.js",
      "assets/**/*",
      "LICENSE",
      "NOTICE.md",
      "CHANGELOG.md"
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "Harriszed",
        "repo": "claude-desktop-pet"
      }
    ],
    "artifactName": "Claude-Desktop-Pet-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Claude-Desktop-Pet-${version}-Setup-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Claude Desktop Pet checks fullscreen apps and focuses your Claude Code session when you click a session chip."
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "maintainer": "Harriszed",
      "desktop": {
        "entry": {
          "StartupWMClass": "claude-desktop-pet"
        }
      }
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
